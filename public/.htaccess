# Hostinger Apache / LiteSpeed Sunucu Yapılandırması
# React SPA ve Gök Atlası Web Uygulaması için Yönlendirme Kuralları

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS zorunlu kılma (SSL Güvenliği)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Eğer istenen dosya veya klasör gerçekten varsa doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Diğer tüm istekleri React Single Page Application (index.html)'e yönlendir
  RewriteRule ^ index.html [L]
</IfModule>

# Tarayıcı Önbellekleme (Statik Varlıklar için Hız Optimizasyonu)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Gzip Sıkıştırma (Hızlı Yükleme)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
